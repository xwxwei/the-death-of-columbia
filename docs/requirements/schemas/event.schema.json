{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeathOfColumbiaEvent",
  "type": "object",
  "required": ["id", "round", "title", "description", "required", "effects"],
  "properties": {
    "id": { "type": "string" },
    "round": { "type": "integer", "minimum": 1, "maximum": 3 },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "required": { "type": "boolean" },
    "trigger_conditions": { "type": "object" },
    "unlocks_clues": { "type": "array", "items": { "type": "string" } },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["variable", "delta", "reason"],
        "properties": {
          "variable": { "type": "string" },
          "delta": { "type": "integer" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
